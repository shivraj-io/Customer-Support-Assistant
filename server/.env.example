# Set one provider key for live classification.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# MongoDB connection string.
MONGO_URI=

# Optional overrides. Defaults are suitable for the respective APIs.
AI_PROVIDER=
# Optional comma-separated failover order, for example: gemini,openai,anthropic
AI_PROVIDER_ORDER=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-2.5-flash
